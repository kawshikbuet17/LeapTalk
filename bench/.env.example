# Web UI settings for bench/ui_server.py. Copy to bench/.env (gitignored) and fill in.
# --scheme / --port on the command line override these.
# Scheme: https or http. Mic record and echo need https (browsers allow the mic only there or on localhost).
LEAPTALK_UI_SCHEME=https
LEAPTALK_UI_PORT=8075
LEAPTALK_UI_DOMAIN=your.domain.example
# Full-chain certificate and its private key (needed for https only)
LEAPTALK_UI_SSL_CERT=/path/to/fullchain.crt
LEAPTALK_UI_SSL_KEY=/path/to/private.key
# Precisions to load: bf16, fp8, or bf16,fp8 (both; switch per request in the UI + A/B compare).
# fp8 needs an RTX 40xx/H100 GPU and torchao (see RUN_FP8.md). --precisions on the command line overrides.
LEAPTALK_UI_PRECISIONS=bf16
